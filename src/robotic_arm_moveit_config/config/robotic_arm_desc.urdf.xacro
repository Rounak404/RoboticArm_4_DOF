<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robotic_arm_desc">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import robotic_arm_desc urdf file -->
    <xacro:include filename="$(find robotic_arm_desc)/urdf/robotic_arm.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="robotic_arm_desc.ros2_control.xacro" />


    <xacro:robotic_arm_desc_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
